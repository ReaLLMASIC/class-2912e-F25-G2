VERSION 5.7 ;
  NOWIREEXTENSIONATPIN ON ;
  DIVIDERCHAR "/" ;
  BUSBITCHARS "[]" ;
MACRO Resistor_Ladder
  CLASS BLOCK ;
  FOREIGN Resistor_Ladder ;
  ORIGIN 1.050 12.755 ;
