      LAYER Metal1 ;
        RECT -0.995 3.335 99.195 3.650 ;
        RECT -0.995 0.290 94.910 3.335 ;
        RECT -0.995 -0.650 28.255 0.290 ;
        RECT 29.155 -0.650 48.655 0.290 ;
        RECT 49.555 -0.650 69.055 0.290 ;
        RECT 69.955 -0.650 89.455 0.290 ;
        RECT 90.355 -0.365 94.910 0.290 ;
        RECT 98.490 -0.365 99.195 3.335 ;
        RECT 90.355 -0.650 99.195 -0.365 ;
        RECT -0.995 -8.455 99.195 -0.650 ;
        RECT -0.995 -9.395 18.055 -8.455 ;
        RECT 18.955 -9.395 38.455 -8.455 ;
        RECT 39.355 -9.395 58.855 -8.455 ;
        RECT 59.755 -9.395 79.255 -8.455 ;
        RECT 80.155 -9.395 92.855 -8.455 ;
        RECT 93.755 -9.395 99.195 -8.455 ;
        RECT -0.995 -12.755 99.195 -9.395 ;
