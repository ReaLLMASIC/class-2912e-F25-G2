    ANTENNADIFFAREA 103.729500 ;
    PORT
      LAYER Metal1 ;
        RECT 95.210 -0.065 98.190 3.035 ;
    END
  END GND
  PIN SB<7>
    PORT
      LAYER Metal1 ;
        RECT 89.755 -0.350 90.055 -0.010 ;
    END
  END SB<7>
  PIN SB<6>
    PORT
      LAYER Metal1 ;
        RECT 79.555 -9.095 79.855 -8.755 ;
